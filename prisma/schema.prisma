generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum InventoryMovementType {
  INITIAL
  RESTOCK
  SALE
  RETURN
  DAMAGE
  LOSS
  CORRECTION
  MANUAL_ADJUSTMENT
}

enum PaymentProvider {
  CASH_ON_DELIVERY
  MANUAL
  SSLCOMMERZ
  STRIPE
}

enum TransactionStatus {
  INITIATED
  PENDING
  VERIFIED
  SUCCESS
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  role          Role      @default(CUSTOMER)
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  phone         String?   @unique
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts             Account[]
  sessions             Session[]
  wishlists            Wishlist[]
  carts                Cart[]
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  inventoryMovements   InventoryMovement[]  @relation("InventoryMovementActor")
  orderStatusHistories OrderStatusHistory[] @relation("StatusHistoryActor")
  couponRedemptions    CouponRedemption[]

  @@map("users")
}

model Account {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  type                     String
  provider                 String
  providerAccountId        String   @map("provider_account_id")
  refresh_token            String?  @db.Text
  access_token             String?  @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?  @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, token])
  @@unique([token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  bengaliName String?  @map("bengali_name")
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent           Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]       @relation("CategoryHierarchy")
  products         Product[]
  couponCategories CouponCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  sku               String        @unique
  slug              String        @unique
  name              String
  bengaliName       String?       @map("bengali_name")
  shortDescription  String?       @map("short_description")
  description       String?       @db.Text
  price             Decimal       @db.Decimal(12, 2)
  compareAtPrice    Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice         Decimal?      @map("cost_price") @db.Decimal(12, 2)
  status            ProductStatus @default(DRAFT)
  trackInventory    Boolean       @default(true) @map("track_inventory")
  stockQuantity     Int           @default(0) @map("stock_quantity")
  lowStockThreshold Int?          @map("low_stock_threshold")
  isFeatured        Boolean       @default(false) @map("is_featured")
  plantSize         String?       @map("plant_size")
  indoorOutdoor     String?       @map("indoor_outdoor")
  difficulty        String?
  lightRequirement  String?       @map("light_requirement")
  waterRequirement  String?       @map("water_requirement")
  seoTitle          String?       @map("seo_title")
  seoDescription    String?       @map("seo_description") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  wishlists          Wishlist[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  inventoryMovements InventoryMovement[]
  couponProducts     CouponProduct[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([name])
  @@map("products")
}

model InventoryMovement {
  id               String                @id @default(uuid()) @db.Uuid
  productId        String?               @map("product_id") @db.Uuid
  performedById    String?               @map("performed_by_id") @db.Uuid
  type             InventoryMovementType
  quantity         Int
  previousStock    Int                   @map("previous_stock")
  newStock         Int                   @map("new_stock")
  reason           String                @db.VarChar(120)
  note             String?               @db.VarChar(500)
  reference        String?               @db.VarChar(160)
  productName      String                @map("product_name") @db.VarChar(200)
  productSku       String                @map("product_sku") @db.VarChar(160)
  performedByEmail String?               @map("performed_by_email") @db.VarChar(320)
  performedByName  String?               @map("performed_by_name") @db.VarChar(200)
  createdAt        DateTime              @default(now()) @map("created_at")

  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  performedBy User?    @relation("InventoryMovementActor", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([performedById, createdAt])
  @@map("inventory_movements")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.Text
  publicId  String?  @map("public_id")
  secureUrl String?  @map("secure_url") @db.Text
  width     Int?
  height    Int?
  format    String?
  bytes     Int?
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  sessionKey String?    @unique @map("session_key")
  status     CartStatus @default(ACTIVE)
  currency   String     @default("BDT") @db.VarChar(3)
  expiresAt  DateTime?  @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  order Order?

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Address {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  type          AddressType @default(SHIPPING)
  label         String?
  recipientName String      @map("recipient_name")
  phone         String
  addressLine1  String      @map("address_line_1")
  addressLine2  String?     @map("address_line_2")
  area          String?
  city          String
  district      String
  postalCode    String?     @map("postal_code")
  country       String      @default("Bangladesh")
  isDefault     Boolean     @default(false) @map("is_default")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")

  @@index([userId, type])
  @@map("addresses")
}

model Order {
  id                    String            @id @default(uuid()) @db.Uuid
  orderNumber           String            @unique @map("order_number")
  userId                String?           @map("user_id") @db.Uuid
  sourceCartId          String?           @unique @map("source_cart_id") @db.Uuid
  shippingAddressId     String?           @map("shipping_address_id") @db.Uuid
  billingAddressId      String?           @map("billing_address_id") @db.Uuid
  status                OrderStatus       @default(PENDING)
  paymentStatus         PaymentStatus     @default(PENDING) @map("payment_status")
  fulfillmentStatus     FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  currency              String            @default("BDT") @db.VarChar(3)
  subtotal              Decimal           @db.Decimal(12, 2)
  discountTotal         Decimal           @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal         Decimal           @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal              Decimal           @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal            Decimal           @map("grand_total") @db.Decimal(12, 2)
  paymentProvider       String?           @map("payment_provider")
  paymentMethod         String?           @map("payment_method")
  paymentReference      String?           @map("payment_reference")
  customerName          String?           @map("customer_name")
  customerEmail         String?           @map("customer_email")
  customerPhone         String?           @map("customer_phone")
  shippingAddressLine1  String?           @map("shipping_address_line_1")
  shippingAddressLine2  String?           @map("shipping_address_line_2")
  shippingCity          String?           @map("shipping_city")
  shippingDistrict      String?           @map("shipping_district")
  shippingArea          String?           @map("shipping_area")
  shippingPostalCode    String?           @map("shipping_postal_code")
  customerNote          String?           @map("customer_note") @db.Text
  adminNotes            String?           @map("admin_notes") @db.Text
  couponCode            String?           @map("coupon_code")
  couponDiscountTotal   Decimal           @default(0) @map("coupon_discount_total") @db.Decimal(12, 2)
  appliedCouponId       String?           @map("applied_coupon_id") @db.Uuid
  shippingZoneName      String?           @map("shipping_zone_name")
  shippingMethodName    String?           @map("shipping_method_name")
  shippingCost          Decimal           @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  estimatedDeliveryText String?           @map("estimated_delivery_text")
  placedAt              DateTime?         @map("placed_at")
  cancelledAt           DateTime?         @map("cancelled_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceCart          Cart?                @relation(fields: [sourceCartId], references: [id], onDelete: SetNull)
  shippingAddress     Address?             @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress      Address?             @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  appliedCoupon       Coupon?              @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  couponRedemption    CouponRedemption?
  paymentTransactions PaymentTransaction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  sku             String
  productName     String   @map("product_name")
  productImageUrl String?  @map("product_image_url") @db.Text
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  status          OrderStatus
  paymentStatus   PaymentStatus? @map("payment_status")
  note            String?        @db.Text
  performedById   String?        @map("performed_by_id") @db.Uuid
  performedByName String?        @map("performed_by_name")
  performedByRole String?        @map("performed_by_role")
  createdAt       DateTime       @default(now()) @map("created_at")

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  performedBy User? @relation("StatusHistoryActor", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_histories")
}

model Review {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String?      @map("user_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  orderItemId        String?      @unique @map("order_item_id") @db.Uuid
  rating             Int
  title              String?
  body               String?      @db.Text
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  publishedAt        DateTime?    @map("published_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status])
  @@map("reviews")
}

model PaymentTransaction {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  provider          PaymentProvider
  method            String?
  status            TransactionStatus @default(INITIATED)
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("BDT") @db.VarChar(3)
  transactionId     String?           @unique @map("transaction_id")
  providerReference String?           @map("provider_reference")
  idempotencyKey    String?           @unique @map("idempotency_key")
  failureReason     String?           @map("failure_reason") @db.Text
  rawMetadataJson   String?           @map("raw_metadata_json") @db.Text
  initiatedAt       DateTime          @default(now()) @map("initiated_at")
  verifiedAt        DateTime?         @map("verified_at")
  failedAt          DateTime?         @map("failed_at")
  refundedAt        DateTime?         @map("refunded_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, status])
  @@map("payment_transactions")
}

model Coupon {
  id                    String     @id @default(uuid()) @db.Uuid
  code                  String     @unique
  name                  String
  description           String?    @db.Text
  type                  CouponType
  value                 Decimal    @db.Decimal(12, 2)
  minimumOrderAmount    Decimal?   @map("minimum_order_amount") @db.Decimal(12, 2)
  maximumDiscountAmount Decimal?   @map("maximum_discount_amount") @db.Decimal(12, 2)
  usageLimit            Int?       @map("usage_limit")
  usageLimitPerCustomer Int?       @map("usage_limit_per_customer")
  usedCount             Int        @default(0) @map("used_count")
  startsAt              DateTime?  @map("starts_at")
  expiresAt             DateTime?  @map("expires_at")
  isActive              Boolean    @default(true) @map("is_active")
  appliesToAllProducts  Boolean    @default(true) @map("applies_to_all_products")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  targetProducts   CouponProduct[]
  targetCategories CouponCategory[]
  redemptions      CouponRedemption[]
  orders           Order[]

  @@index([code])
  @@index([isActive, startsAt, expiresAt])
  @@map("coupons")
}

model CouponProduct {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  id         String   @id @default(uuid()) @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  customerEmail  String   @map("customer_email")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, redeemedAt])
  @@index([userId, couponId])
  @@map("coupon_redemptions")
}

model ShippingZone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  countries String   @default("Bangladesh")
  regions   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rates ShippingRate[]

  @@index([isActive, priority])
  @@map("shipping_zones")
}

model ShippingRate {
  id                    String   @id @default(uuid()) @db.Uuid
  zoneId                String   @map("zone_id") @db.Uuid
  name                  String
  method                String
  amount                Decimal  @db.Decimal(12, 2)
  minimumOrderAmount    Decimal? @map("minimum_order_amount") @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(12, 2)
  estimatedDeliveryText String?  @map("estimated_delivery_text")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, isActive])
  @@map("shipping_rates")
}

model BlogPost {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  coverImage  String?  @map("cover_image")
  category    String   @default("Plant Care")
  tags        String[] @default([])
  authorName  String   @default("Pick Plant Team") @map("author_name")
  readingTime String   @default("4 min read") @map("reading_time")
  isPublished Boolean  @default(true) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model ContactMessage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  subject     String
  inquiryType String   @default("General Inquiry") @map("inquiry_type")
  message     String   @db.Text
  status      String   @default("NEW")
  adminNote   String?  @map("admin_note") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}
