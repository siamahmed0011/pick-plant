# Application (Production requires an absolute https:// origin URL)
NODE_ENV=
NEXT_PUBLIC_SITE_URL=

# Email Service (Production requires HTTPS site URL, EMAIL_FROM, and active RESEND_API_KEY)
RESEND_API_KEY=
EMAIL_FROM=

# Database
DATABASE_URL=
DIRECT_URL=


# Authentication
AUTH_SECRET=
AUTH_TRUST_HOST=

# Initial administrator provisioning
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=

# Scheduled order expiration
CRON_SECRET=

# Upstash Redis & Proxy Trust (Production rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRUST_CLOUDFLARE_PROXY=false

